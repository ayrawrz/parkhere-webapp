                  "id": "d5b5d075-c609-46ce-b8f0-668f7e26f92a",
                  "title": "Parking or Payment Data Manipulation",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "A malicious user may manipulate parking duration, payment amount, or other parking data processed on the client side before the data is stored.",
                  "mitigation": "Validate and calculate sensitive parking and payment data on a trusted backend instead of relying only on client-side values.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "e095f574-4f3e-44b0-94ca-27bdaa6e1230",
                  "title": "Parking Transaction Cannot Be Fully Audited",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "A user may deny performing a parking or payment action if the system does not maintain a reliable audit trail of important activities.",
                  "mitigation": "Maintain server-generated audit logs for important actions such as starting parking, ending parking, and payment activities.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                },
                {
                  "id": "469ec180-6f60-4489-adaa-8319cc535ea0",
                  "title": "Unauthorized Privileged Data Modification",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "A regular authenticated user may gain permissions beyond the intended access level and modify protected parking or application data.",
                  "mitigation": "Enforce authorization checks and Firestore Security Rules so users can only perform actions and modify data permitted for their account.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 8,
                  "score": ""
                }
